{
  "statusLine": [
    "model-with-reasoning",
    "git-branch",
    "current-dir"
  ],
  "layout": {
    "footer": "minimal"
  },
  "theme": {
    "source": "ghostty"
  },
  "changes": {
    "lastChangedFileDiff": "visible"
